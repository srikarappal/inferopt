# Isolated toolchains. Both exist because their pins CANNOT coexist with vLLM's:
#   .aic-pkgs    aiconfigurator wants numpy~=1.26.4, vLLM wants <2.4
#   .quant-pkgs  llmcompressor wants compressed-tensors==0.18.0, vLLM pins ==0.17.0
#   .evalplus-pkgs  evalplus drags in openai/anthropic/google-generativeai for ITS
#                   generation backends, which we do not use -- we generate with
#                   vLLM. Kept out of the serving env on principle: this project
#                   has been broken twice by a dep installed for a side feature.
# Rebuild with: python quantize.py --setup, or for evalplus:
#   pip install --target .evalplus-pkgs --no-deps evalplus tempdir appdirs \
#       multipledispatch wget termcolor fire tree-sitter tree-sitter-python
.aic-pkgs/
.quant-pkgs/
.evalplus-pkgs/
.venv-aic/

# Measurement output and generated inputs -- machine-specific, and large.
runs/
data/
artifacts/
calibration.json

# registry.json was a cache for the Hub-lookup approach that got deleted.
registry.json

__pycache__/
*.pyc

# Claude Code session transcripts, not project code.
2026-*-local-command-*.txt

# vLLM's compile cache, written by VLLM_CACHE_ROOT into each run directory.
# Machine-specific (Inductor kernels for one exact GPU / torch / CUDA / vLLM
# triple), regenerated on the next launch, and read by nothing in the analysis
# path. 575 of these reached runs_h100/ because `runs/` was ignored and
# `runs_h100/` was not: 440 MB, 83% of the tracked tree, against 87 MB for
# everything else. Matched at any depth so a new runs_<host>/ cannot repeat it.
.vllm_cache/
.vllm-cache/
